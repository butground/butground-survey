# 저장 방식 선택: 'webhook'(기본값, Apps Script 웹앱) | 'service-account'(googleapis 직접 연동)
SHEETS_SAVE_MODE=webhook

# --- 방식 1: Apps Script 웹앱 프록시 (기본값) ---
# Google Apps Script를 웹앱으로 배포한 뒤(액세스 권한: 모든 사용자, 실행 사용자: 나) 그 주소를 넣어주세요.
# doPost/doGet 코드는 README.md 참고.
GOOGLE_SHEETS_WEBHOOK_URL=

# --- 방식 2: 서비스 계정으로 구글 시트에 직접 append (확장용) ---
# 서비스 계정을 만들고, 아래 이메일을 대상 스프레드시트에 "편집자"로 공유해야 합니다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 개행 문자는 \n으로 이스케이프해서 한 줄로 넣어주세요.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
